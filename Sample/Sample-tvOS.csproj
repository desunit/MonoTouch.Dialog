<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-tvos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <DefineConstants>__TVOS__;__UNIFIED__</DefineConstants>
    <RootNamespace>Sample</RootNamespace>
    <AssemblyName>Sample</AssemblyName>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <ApplicationId>com.sample.monotouchdialog.tvos</ApplicationId>
    <ApplicationTitle>MonoTouch.Dialog Sample tvOS</ApplicationTitle>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <!-- Info.plist -->
  <ItemGroup>
    <None Remove="Info.plist" />
    <None Include="Info-tvOS.plist" />
  </ItemGroup>

  <!-- Project reference to MonoTouch.Dialog -->

  <!-- Content files -->
  <ItemGroup>
    <BundleResource Include="monodevelop-32.png" />
    <BundleResource Include="caltemplate.png" />
    <BundleResource Include="jakub-calendar.png" />
    <BundleResource Include="favorite.png" />
    <BundleResource Include="favorited.png" />
    <BundleResource Include="background.png" />
    <BundleResource Include="sample.json" />
  </ItemGroup>
</Project>
